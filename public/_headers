# Cloudflare static asset response headers (copied verbatim from public/ into dist/).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Astro/Vite emit content-hashed filenames here, so they are safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

