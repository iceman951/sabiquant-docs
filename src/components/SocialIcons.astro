---
import DefaultSocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
---

<div class="custom-social-wrapper">
  <DefaultSocialIcons><slot /></DefaultSocialIcons>
  <a
    href="https://crates.io/crates/sabiquant"
    target="_blank"
    rel="noopener noreferrer"
    class="crates-icon-link"
    title="SabiQuant on Crates.io"
    aria-label="Crates.io"
  >
    <svg viewBox="0 0 512 512" fill="currentColor" width="20" height="20" aria-hidden="true">
      <path d="M239.1 6.3l-208 78c-18.7 7-31.1 25-31.1 45v253.4c0 20 12.4 38 31.1 45l208 78c10.9 4.1 22.9 4.1 33.8 0l208-78c18.7-7 31.1-25 31.1-45V129.3c0-20-12.4-38-31.1-45l-208-78c-10.9-4.1-22.9-4.1-33.8 0zM256 66.8l160.6 60.2L358 150.3 197.4 90.1 256 66.8zm-178 77.1l146 54.8v180.5l-146-54.8V143.9zm178 235.3V198.7l146-54.8v180.5l-146 54.8z"/>
    </svg>
  </a>
</div>

<style>
  .custom-social-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
  .crates-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--sl-color-text-accent);
    padding: 0.5em;
    border-radius: 0.25rem;
    transition: opacity 0.15s ease, color 0.15s ease;
  }
  .crates-icon-link:hover {
    color: var(--sl-color-white);
    opacity: 0.8;
  }
</style>

